# Copy this file to ~/.config/flipperone-osint/ai.env on Flipper OS.
# Fill in your own keys. NEVER commit your real credentials to GitHub.
# 1) Brave Search is optional for broad web and PDF discovery:
BRAVE_SEARCH_API_KEY=

# 2) Small generative model is optional. Local extractive NLP works without it.
# For llama.cpp on the Flipper, configure an OpenAI-compatible local server.
# Example: http://127.0.0.1:8080/v1/chat/completions
AI_CHAT_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=

# For a remote hosted model AI_CHAT_URL must use HTTPS.
# Restart the app after editing this file.
