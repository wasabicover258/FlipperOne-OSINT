#!/bin/sh
# FlipperOne-OSINT: native UI (SDL2) + backend (osint-cli) from the same bundle.
set -eu
APPDIR=${APPDIR:-$(cd "$(dirname "$0")" && pwd)}
export APPDIR
# Outside the panel: hand the bundle to flipctl like a real Flipper app.
if [ -z "${FLIPCTL_HOSTED:-}" ]; then
    exec flipctl open "${APPIMAGE:-$0}"
fi

# Start log (for troubleshooting): /tmp/flipperone-osint.log
LOG="${TMPDIR:-/tmp}/flipperone-osint.log"
{ [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 100000 ] && : > "$LOG"; } 2>/dev/null || true
{
  echo "== $(date) Start AppRun"
  echo "HOSTED=${FLIPCTL_HOSTED:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-} DISPLAY=${DISPLAY:-} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-} SDL_VIDEODRIVER=${SDL_VIDEODRIVER:-}"
  echo "APPIMAGE=${APPIMAGE:-?} APPDIR=$APPDIR arch=$(uname -m 2>&1)"
  echo "python3: $(command -v python3 2>&1 || echo 'not found')"
  ls -l "$APPDIR/usr/bin" 2>&1
} >> "$LOG" 2>&1 || true

# Not exec: the exit code is what tells a failing start from a normal one.
set +e
"$APPDIR/usr/bin/osint-ui" "$APPDIR/usr/bin/osint-cli" >> "$LOG" 2>&1
rc=$?
set -e
echo "== osint-ui exit $rc" >> "$LOG" 2>&1
# A start that failed is only useful if the log can be read: put a copy where the
# Flipper One File Manager shows it. On success nothing is written there.
if [ "$rc" -ne 0 ] && [ -d /home/user/Files ]; then
    cp "$LOG" /home/user/Files/flipperone-osint-start.log 2>/dev/null || true
fi
exit "$rc"
